// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "git_panel": {
    "group_by": "staging"
  },
  "agent_servers": {
    "codex-acp": {
      "default_config_options": {
        "model": "gpt-6.1-sol"
      },
      "type": "registry"
    }
  },
  "title_bar": {
    "show_sign_in": false,
  },
  "telemetry": {
    "metrics": false,
    "diagnostics": false,
  },
  "vim_mode": true,
  "vim": {
    "use_system_clipboard": "never",
  },
  "auto_install_extensions": {
    "dockerfile": true,
    "elm": true,
    "haskell": true,
    "html": true,
    "make": true,
    "php": true
  },
  "languages": {
    "PHP": {
      "format_on_save": "off",
    },
    "Haskell": {
      "formatter": {
        "external": {
          "command": "fourmolu",
          "arguments": ["--stdin-input-file", ""],
        },
      },
    },
  },
  "lsp": {
    "vtsls": {
      "settings": {
        "typescript": {
          "preferences": {
            "importModuleSpecifier": "non-relative",
          },
        },
      },
    },
  },
  "theme_overrides": {
    "One Dark": {
      "editor.active_line_number": "#dce0e5ff",

      "syntax": {
        "constant": {
          "color": "#acb2beff",
          "font_style": "italic"
        },

        "constructor": {
          "color": "#acb2beff"
        },

        "namespace": {
          "color": "#56b6c2ff"
        },

        "tag": {
          "color": "#56b6c2ff"
        },

        "attribute": {
          "color": "#61afefff",
          "font_style": "italic"
        },

        "type": {
          "color": "#56b6c2ff"
        },

        "variable.parameter": {
          "color": "#acb2beff"
        },

        "variable.special": {
          "color": "#56b6c2ff"
        },

        "title": {
          "color": "#56b6c2ff",
          "font_weight": 700
        }
      }
    }
  }
}
