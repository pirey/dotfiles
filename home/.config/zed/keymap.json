// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
  {
    "context": "Editor",
    "bindings": {
      "ctrl-m": "editor::Newline",
      "ctrl-shift-tab": "pane::ActivatePreviousItem",
      "ctrl-tab": "pane::ActivateNextItem",
    },
  },
  {
    "context": "vim_mode == normal",
    "bindings": {
      ";": "command_palette::Toggle",
      ":": "vim::RepeatFind",
      "g p": ["workspace::SendKeystrokes", "`[v`]"],
    },
  },
  {
    "context": "Terminal",
    "bindings": {
      // "j k": ["workspace::SendKeystrokes", "escape"]
      "ctrl-shift-tab": "pane::ActivatePreviousItem",
      "ctrl-tab": "pane::ActivateNextItem",
      "cmd-[": "workspace::ActivatePaneLeft",
      "cmd-]": "workspace::ActivatePaneRight"
    },
  },
  {
    "context": "(vim_mode == normal || vim_mode == visual) && !menu",
    "bindings": {
      "s": "vim::HelixJumpToWord",
      "g a": "pane::AlternateFile",
      "g l": ["workspace::SendKeystrokes", "$"],
      "g h": ["workspace::SendKeystrokes", "0"],
      "j": ["workspace::SendKeystrokes", "g j"],
      "k": ["workspace::SendKeystrokes", "g k"],
      "m m": ["workspace::SendKeystrokes", "%"],
    }
  },
  {
    "context": "vim_mode == visual && !menu",
    "bindings": {
      "g l": ["workspace::SendKeystrokes", "$ h"],
      "a m": ["workspace::SendKeystrokes", "a %"],
    }
  },
  {
    "context": "Workspace",
    "bindings": {
      "ctrl-shift-r": "projects::OpenRecent"
    }
  }
]
